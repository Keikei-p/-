rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function companyPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId);
    }

    function memberPath(companyId, userId) {
      return /databases/$(database)/documents/companies/$(companyId)/members/$(userId);
    }

    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }

    function invitationPath(inviteId) {
      return /databases/$(database)/documents/invitations/$(inviteId);
    }

    function validRole(role) {
      return role == 'member' || role == 'leader';
    }

    function validTeamId(teamId) {
      return teamId == null || teamId is string;
    }

    function validSelectableTeam(companyId, teamId) {
      return teamId == null
        || (
          teamId is string
          && exists(teamPath(teamId))
          && get(teamPath(teamId)).data.companyId == companyId
          && get(teamPath(teamId)).data.active == true
        );
    }

    function validTeamHistory(data) {
      return !data.keys().hasAny(['teamHistory'])
        || (
          data.teamHistory is list
          && data.teamHistory.size() <= 100
        );
    }

    function validShortName(name, maxLength) {
      return name is string
        && name.size() >= 1
        && name.size() <= maxLength;
    }

    function activeOrLegacy(data) {
      return !data.keys().hasAny(['active'])
        || data.active == true;
    }

    function currentCompanyId() {
      return get(userPath(request.auth.uid)).data.companyId;
    }

    function isCompanyMember(companyId) {
      return verifiedUser()
        && companyId != null
        && exists(memberPath(companyId, request.auth.uid))
        && activeOrLegacy(get(memberPath(companyId, request.auth.uid)).data)
        && get(userPath(request.auth.uid)).data.companyId == companyId
        && activeOrLegacy(get(userPath(request.auth.uid)).data);
    }

    function isCompanyLeader(companyId) {
      return isCompanyMember(companyId)
        && get(memberPath(companyId, request.auth.uid)).data.role == 'leader';
    }

    function isCompanyOwner(companyId) {
      return verifiedUser()
        && companyId != null
        && exists(companyPath(companyId))
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.companyId == companyId
        && activeOrLegacy(get(userPath(request.auth.uid)).data)
        && get(userPath(request.auth.uid)).data.companyRole == 'owner'
        && exists(memberPath(companyId, request.auth.uid))
        && activeOrLegacy(get(memberPath(companyId, request.auth.uid)).data)
        && get(memberPath(companyId, request.auth.uid)).data.companyRole == 'owner';
    }

    function isCompanyManager(companyId) {
      return isCompanyLeader(companyId)
        || isCompanyOwner(companyId);
    }

    function isLeaderOfTeam(companyId, teamId) {
      return isCompanyLeader(companyId)
        && teamId != null
        && get(memberPath(companyId, request.auth.uid)).data.teamId == teamId;
    }

    function canManageTeamMemberRecord(companyId, targetUid, teamId) {
      return isLeaderOfTeam(companyId, teamId)
        && exists(memberPath(companyId, targetUid))
        && activeOrLegacy(get(memberPath(companyId, targetUid)).data)
        && get(memberPath(companyId, targetUid)).data.teamId == teamId;
    }

    function validOwnerPromotion(companyId, targetUid) {
      return isCompanyOwner(companyId)
        && targetUid != request.auth.uid
        && existsAfter(userPath(targetUid))
        && getAfter(userPath(targetUid)).data.companyId == companyId
        && getAfter(userPath(targetUid)).data.companyRole == 'owner'
        && getAfter(userPath(targetUid)).data.role == 'leader'
        && getAfter(userPath(targetUid)).data.active == true
        && existsAfter(memberPath(companyId, targetUid))
        && getAfter(memberPath(companyId, targetUid)).data.companyRole == 'owner'
        && getAfter(memberPath(companyId, targetUid)).data.role == 'leader'
        && getAfter(memberPath(companyId, targetUid)).data.active == true;
    }

    function validOwnerTransfer(companyId) {
      let newOwnerUid = getAfter(companyPath(companyId)).data.ownerUid;

      return isCompanyOwner(companyId)
        && newOwnerUid is string
        && newOwnerUid != request.auth.uid
        && existsAfter(userPath(newOwnerUid))
        && getAfter(userPath(newOwnerUid)).data.companyId == companyId
        && getAfter(userPath(newOwnerUid)).data.companyRole == 'owner'
        && getAfter(userPath(newOwnerUid)).data.role == 'leader'
        && getAfter(userPath(newOwnerUid)).data.active == true
        && existsAfter(memberPath(companyId, newOwnerUid))
        && getAfter(memberPath(companyId, newOwnerUid)).data.companyRole == 'owner'
        && getAfter(memberPath(companyId, newOwnerUid)).data.role == 'leader'
        && getAfter(memberPath(companyId, newOwnerUid)).data.active == true
        && getAfter(userPath(request.auth.uid)).data.companyId == companyId
        && getAfter(userPath(request.auth.uid)).data.companyRole == 'member'
        && getAfter(userPath(request.auth.uid)).data.role == 'leader'
        && getAfter(userPath(request.auth.uid)).data.active == true
        && getAfter(memberPath(companyId, request.auth.uid)).data.companyRole == 'member'
        && getAfter(memberPath(companyId, request.auth.uid)).data.role == 'leader'
        && getAfter(memberPath(companyId, request.auth.uid)).data.active == true;
    }

    function sameCompany(companyId) {
      return companyId != null
        && currentCompanyId() == companyId
        && (
          isCompanyMember(companyId)
          || isCompanyOwner(companyId)
        );
    }

    function ownerBootstrap(companyId, memberId) {
      return verifiedUser()
        && memberId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'role', 'companyRole',
          'teamId', 'active', 'joinedAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && validShortName(request.resource.data.name, 30)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'leader'
        && request.resource.data.companyRole == 'owner'
        && request.resource.data.teamId == null
        && request.resource.data.active == true
        && request.resource.data.joinedAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(companyPath(companyId))
        && getAfter(companyPath(companyId)).data.ownerUid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.companyId == companyId;
    }

    function acceptedInvitation(companyId, memberId) {
      return verifiedUser()
        && memberId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'role', 'companyRole',
          'teamId', 'active', 'invitationId', 'joinedAt', 'updatedAt'
        ])
        && request.resource.data.invitationId is string
        && existsAfter(invitationPath(request.resource.data.invitationId))
        && getAfter(invitationPath(request.resource.data.invitationId)).data.companyId == companyId
        && getAfter(invitationPath(request.resource.data.invitationId)).data.email == request.auth.token.email
        && getAfter(invitationPath(request.resource.data.invitationId)).data.status == 'accepted'
        && getAfter(invitationPath(request.resource.data.invitationId)).data.acceptedBy == request.auth.uid
        && getAfter(invitationPath(request.resource.data.invitationId)).data.expiresAt > request.time
        && request.resource.data.uid == request.auth.uid
        && validShortName(request.resource.data.name, 30)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == getAfter(invitationPath(request.resource.data.invitationId)).data.role
        && validRole(request.resource.data.role)
        && request.resource.data.companyRole == 'member'
        && request.resource.data.teamId == null
        && request.resource.data.active == true
        && request.resource.data.joinedAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(userPath(request.auth.uid)).data.companyId == companyId;
    }

    function joinsCompany(userId) {
      return verifiedUser()
        && isSelf(userId)
        && resource.data.companyId == null
        && request.resource.data.companyId is string
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.active == true
        && validRole(request.resource.data.role)
        && validTeamId(request.resource.data.teamId)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'companyId',
            'companyRole',
            'role',
            'teamId',
            'updatedAt'
          ])
        && existsAfter(memberPath(request.resource.data.companyId, userId))
        && getAfter(memberPath(request.resource.data.companyId, userId)).data.uid == userId
        && getAfter(memberPath(request.resource.data.companyId, userId)).data.email == request.auth.token.email
        && getAfter(memberPath(request.resource.data.companyId, userId)).data.role == request.resource.data.role
        && getAfter(memberPath(request.resource.data.companyId, userId)).data.companyRole == request.resource.data.companyRole
        && getAfter(memberPath(request.resource.data.companyId, userId)).data.active == true;
    }

    match /users/{userId} {
      allow get: if verifiedUser()
        && (
          isSelf(userId)
          || (
            resource.data.companyId != null
            && isCompanyManager(resource.data.companyId)
          )
        );

      allow list: if verifiedUser()
        && resource.data.companyId != null
        && isCompanyManager(resource.data.companyId);

      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'companyId',
          'role', 'teamId', 'active', 'createdAt'
        ])
        && request.resource.data.uid == userId
        && validShortName(request.resource.data.name, 30)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'member'
        && request.resource.data.teamId == null
        && request.resource.data.companyId == null
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time;

      allow update: if joinsCompany(userId)
        || (
          isSelf(userId)
          && resource.data.active == true
          && validShortName(request.resource.data.name, 30)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'updatedAt'])
        )
        || (
          isSelf(userId)
          && resource.data.companyId != null
          && resource.data.companyRole != 'owner'
          && resource.data.active == true
          && request.resource.data.active == false
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['active', 'updatedAt'])
          && getAfter(memberPath(resource.data.companyId, userId)).data.active == false
        )
        || (
          isSelf(userId)
          && resource.data.companyId != null
          && activeOrLegacy(resource.data)
          && (
            resource.data.role != 'leader'
            || resource.data.companyRole == 'owner'
          )
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.companyRole == resource.data.companyRole
          && request.resource.data.role == resource.data.role
          && validSelectableTeam(
            resource.data.companyId,
            request.resource.data.teamId
          )
          && validTeamHistory(request.resource.data)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['teamId', 'teamHistory', 'updatedAt'])
          && existsAfter(memberPath(resource.data.companyId, userId))
          && getAfter(memberPath(resource.data.companyId, userId)).data.teamId
            == request.resource.data.teamId
          && getAfter(memberPath(resource.data.companyId, userId)).data.teamHistory
            == request.resource.data.teamHistory
        )
        || (
          resource.data.companyId != null
          && isCompanyManager(resource.data.companyId)
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.uid == resource.data.uid
          && (
            isCompanyOwner(resource.data.companyId)
            || userId != request.auth.uid
            || request.resource.data.teamId == resource.data.teamId
          )
          && request.resource.data.email == resource.data.email
          && request.resource.data.companyRole == resource.data.companyRole
          && validShortName(request.resource.data.name, 30)
          && validRole(request.resource.data.role)
          && validTeamId(request.resource.data.teamId)
          && validTeamHistory(request.resource.data)
          && (
            request.resource.data.role != 'leader'
            || request.resource.data.companyRole == 'owner'
            || request.resource.data.teamId != null
          )
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'role', 'teamId', 'teamHistory', 'active', 'updatedAt'])
          && (
            request.resource.data.active == resource.data.active
            || isCompanyOwner(resource.data.companyId)
          )
          && (
            resource.data.companyRole != 'owner'
            || (
              request.resource.data.role == 'leader'
              && request.resource.data.active == true
            )
          )
        )
        || (
          resource.data.companyId != null
          && resource.data.companyRole != 'owner'
          && request.resource.data.companyRole == 'owner'
          && request.resource.data.role == 'leader'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['companyRole', 'role', 'updatedAt'])
          && validOwnerPromotion(resource.data.companyId, userId)
        )
        || (
          resource.data.companyId != null
          && validOwnerTransfer(resource.data.companyId)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['companyRole', 'role', 'updatedAt'])
          && (
            (
              userId == request.auth.uid
              && resource.data.companyRole == 'owner'
              && request.resource.data.companyRole == 'member'
              && request.resource.data.role == 'leader'
            )
            || (
              userId == getAfter(companyPath(resource.data.companyId)).data.ownerUid
              && resource.data.companyRole == 'member'
              && request.resource.data.companyRole == 'owner'
              && request.resource.data.role == 'leader'
            )
          )
        );

      allow delete: if false;
    }

    match /companies/{companyId} {
      allow get: if isCompanyMember(companyId)
        || isCompanyOwner(companyId);
      allow list: if false;

      allow create: if verifiedUser()
        && request.resource.data.keys().hasOnly([
          'name', 'ownerUid', 'active', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && get(userPath(request.auth.uid)).data.companyId == null
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(memberPath(companyId, request.auth.uid))
        && getAfter(memberPath(companyId, request.auth.uid)).data.companyRole == 'owner'
        && getAfter(memberPath(companyId, request.auth.uid)).data.role == 'leader'
        && getAfter(memberPath(companyId, request.auth.uid)).data.active == true
        && getAfter(userPath(request.auth.uid)).data.companyId == companyId;

      allow update: if (
        isCompanyOwner(companyId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.updatedAt == request.time
      )
      || (
        isCompanyOwner(companyId)
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid != resource.data.ownerUid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ownerUid', 'updatedAt'])
        && validOwnerTransfer(companyId)
      );

      allow delete: if false;

      match /members/{memberId} {
        allow get: if isCompanyManager(companyId)
          || (
            memberId == request.auth.uid
            && isCompanyMember(companyId)
          );

        allow list: if isCompanyManager(companyId);

        allow create: if ownerBootstrap(companyId, memberId)
          || acceptedInvitation(companyId, memberId);

        allow update: if (
          isCompanyManager(companyId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && (
            isCompanyOwner(companyId)
            || memberId != request.auth.uid
            || request.resource.data.teamId == resource.data.teamId
          )
          && request.resource.data.companyRole == resource.data.companyRole
          && validShortName(request.resource.data.name, 30)
          && validRole(request.resource.data.role)
          && validTeamId(request.resource.data.teamId)
          && validTeamHistory(request.resource.data)
          && (
            request.resource.data.role != 'leader'
            || request.resource.data.companyRole == 'owner'
            || request.resource.data.teamId != null
          )
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'role', 'teamId', 'teamHistory', 'active', 'updatedAt'])
          && (
            request.resource.data.active == resource.data.active
            || isCompanyOwner(companyId)
          )
          && (
            resource.data.companyRole != 'owner'
            || (
              request.resource.data.role == 'leader'
              && request.resource.data.active == true
            )
          )
        )
        || (
          memberId == request.auth.uid
          && isCompanyMember(companyId)
          && (
            resource.data.role != 'leader'
            || resource.data.companyRole == 'owner'
          )
          && validSelectableTeam(
            companyId,
            request.resource.data.teamId
          )
          && validTeamHistory(request.resource.data)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['teamId', 'teamHistory', 'updatedAt'])
          && existsAfter(userPath(request.auth.uid))
          && getAfter(userPath(request.auth.uid)).data.teamId
            == request.resource.data.teamId
          && getAfter(userPath(request.auth.uid)).data.teamHistory
            == request.resource.data.teamHistory
        )
        || (
          memberId == request.auth.uid
          && isCompanyMember(companyId)
          && validShortName(request.resource.data.name, 30)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'updatedAt'])
        )
        || (
          memberId == request.auth.uid
          && isCompanyMember(companyId)
          && resource.data.companyRole != 'owner'
          && resource.data.active == true
          && request.resource.data.active == false
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['active', 'updatedAt'])
          && getAfter(userPath(request.auth.uid)).data.active == false
        )
        || (
          resource.data.companyRole != 'owner'
          && request.resource.data.companyRole == 'owner'
          && request.resource.data.role == 'leader'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['companyRole', 'role', 'updatedAt'])
          && validOwnerPromotion(companyId, memberId)
        )
        || (
          validOwnerTransfer(companyId)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['companyRole', 'role', 'updatedAt'])
          && (
            (
              memberId == request.auth.uid
              && resource.data.companyRole == 'owner'
              && request.resource.data.companyRole == 'member'
              && request.resource.data.role == 'leader'
            )
            || (
              memberId == getAfter(companyPath(companyId)).data.ownerUid
              && resource.data.companyRole == 'member'
              && request.resource.data.companyRole == 'owner'
              && request.resource.data.role == 'leader'
            )
          )
        );

        allow delete: if false;
      }
    }

    match /invitations/{inviteId} {
      allow get: if verifiedUser()
        && (
          resource.data.email == request.auth.token.email
          || isCompanyManager(resource.data.companyId)
        );

      allow list: if false;

      allow create: if verifiedUser()
        && request.resource.data.keys().hasOnly([
          'companyId', 'companyName', 'email', 'role',
          'status', 'invitedBy', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.companyId is string
        && isCompanyManager(request.resource.data.companyId)
        && request.resource.data.companyName == get(companyPath(request.resource.data.companyId)).data.name
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 254
        && validRole(request.resource.data.role)
        && request.resource.data.status == 'pending'
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'm');

      allow update: if verifiedUser()
        && resource.data.status == 'pending'
        && resource.data.email == request.auth.token.email
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptedBy', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && existsAfter(memberPath(resource.data.companyId, request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.companyId == resource.data.companyId;

      allow delete: if isCompanyManager(resource.data.companyId);
    }

    match /teams/{teamId} {
      allow read: if resource.data.companyId != null
        && sameCompany(resource.data.companyId);

      allow create: if request.resource.data.keys().hasOnly([
          'companyId', 'name', 'leaderUids', 'active', 'createdAt'
        ])
        && request.resource.data.companyId != null
        && currentCompanyId() == request.resource.data.companyId
        && isCompanyManager(request.resource.data.companyId)
        && validShortName(request.resource.data.name, 30)
        && request.resource.data.leaderUids is list
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time;

      allow update: if resource.data.companyId != null
        && isCompanyManager(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && validShortName(request.resource.data.name, 30)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'updatedAt']);

      allow delete: if resource.data.companyId != null
        && isCompanyManager(resource.data.companyId);
    }

    match /products/{productId} {
      allow read: if resource.data.companyId != null
        && sameCompany(resource.data.companyId);

      allow create: if request.resource.data.keys().hasOnly([
          'companyId', 'name', 'revenue', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.companyId != null
        && currentCompanyId() == request.resource.data.companyId
        && isCompanyManager(request.resource.data.companyId)
        && validShortName(request.resource.data.name, 50)
        && request.resource.data.revenue is number
        && request.resource.data.revenue >= 0
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if resource.data.companyId != null
        && isCompanyManager(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && validShortName(request.resource.data.name, 50)
        && request.resource.data.revenue is number
        && request.resource.data.revenue >= 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'revenue', 'updatedAt']);

      allow delete: if resource.data.companyId != null
        && isCompanyManager(resource.data.companyId);
    }

    match /records/{recordId} {
      allow read: if resource.data.companyId != null
        && sameCompany(resource.data.companyId);

      allow create: if request.resource.data.keys().hasOnly([
          'companyId', 'uid', 'memberNameSnapshot', 'teamId',
          'teamNameSnapshot', 'date', 'results', 'totalCount',
          'totalRevenue', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.companyId != null
        && currentCompanyId() == request.resource.data.companyId
        && (
          isCompanyMember(request.resource.data.companyId)
          || isCompanyOwner(request.resource.data.companyId)
        )
        && (
          (
            exists(memberPath(request.resource.data.companyId, request.resource.data.uid))
            && activeOrLegacy(get(memberPath(request.resource.data.companyId, request.resource.data.uid)).data)
          )
          || (
            request.resource.data.uid == request.auth.uid
            && isCompanyOwner(request.resource.data.companyId)
          )
        )
        && request.resource.data.memberNameSnapshot is string
        && validTeamId(request.resource.data.teamId)
        && request.resource.data.teamNameSnapshot is string
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.results is map
        && request.resource.data.totalCount is number
        && request.resource.data.totalCount >= 0
        && request.resource.data.totalRevenue is number
        && request.resource.data.totalRevenue >= 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          isCompanyOwner(request.resource.data.companyId)
          || (
            request.resource.data.uid == request.auth.uid
            && recordId == request.resource.data.companyId + '_' + request.auth.uid + '_' + request.resource.data.date
          )
          || canManageTeamMemberRecord(
            request.resource.data.companyId,
            request.resource.data.uid,
            request.resource.data.teamId
          )
        );

      allow update: if resource.data.companyId != null
        && request.resource.data.companyId == resource.data.companyId
        && sameCompany(resource.data.companyId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.date == resource.data.date
        && request.resource.data.memberNameSnapshot is string
        && validTeamId(request.resource.data.teamId)
        && request.resource.data.teamNameSnapshot is string
        && request.resource.data.results is map
        && request.resource.data.totalCount is number
        && request.resource.data.totalCount >= 0
        && request.resource.data.totalRevenue is number
        && request.resource.data.totalRevenue >= 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'memberNameSnapshot', 'teamId', 'teamNameSnapshot',
            'results', 'totalCount', 'totalRevenue', 'updatedAt'
          ])
        && (
          isCompanyOwner(resource.data.companyId)
          || resource.data.uid == request.auth.uid
          || canManageTeamMemberRecord(
            resource.data.companyId,
            resource.data.uid,
            resource.data.teamId
          )
        );

      allow delete: if resource.data.companyId != null
        && sameCompany(resource.data.companyId)
        && (
          isCompanyOwner(resource.data.companyId)
          || resource.data.uid == request.auth.uid
          || canManageTeamMemberRecord(
            resource.data.companyId,
            resource.data.uid,
            resource.data.teamId
          )
        );
    }

    match /goals/{goalId} {
      allow read, write: if false;
    }
  }
}
